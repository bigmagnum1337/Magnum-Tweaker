<Window x:Class="MagnumTweaker.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Magnum Tweaker · Setup" Icon="Assets/MagnumTweaker.ico" Width="462" Height="362" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Foreground="#F5F5F6" FontFamily="{StaticResource InterfaceFont}" UseLayoutRounding="True" Loaded="Window_Loaded">
  <Window.Resources>
    <Style x:Key="SetupFocus" TargetType="Control">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate>
            <Border CornerRadius="6" BorderBrush="#F5F5F7" BorderThickness="1" IsHitTestVisible="False"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SetupButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FocusVisualStyle" Value="{StaticResource SetupFocus}"/>
    </Style>
    <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource SetupButton}">
      <Setter Property="Height" Value="50"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,0,0,9"/>
    </Style>
    <SolidColorBrush x:Key="WindowsGlyphBrush" Color="#AEAFB4"/>
    <Style x:Key="ChoiceGlyph" TargetType="Path">
      <Setter Property="Fill" Value="{StaticResource WindowsGlyphBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
          <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
          <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border Background="#0B0B0D" BorderBrush="#3D3D40" BorderThickness="1" CornerRadius="11">
    <Grid>
      <Border Height="36" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="DragHeader"/>
      <Button Style="{StaticResource ChromeButton}" Content="×" FontSize="20" HorizontalAlignment="Right"
              FocusVisualStyle="{StaticResource SetupFocus}"
              VerticalAlignment="Top" Margin="0,1,4,0" AutomationProperties.Name="Close / Закрыть" Click="Close_Click"/>
      <StackPanel Margin="36,24,36,0">
        <ContentControl ContentTemplate="{StaticResource BrandMark}" Content="Magnum Tweaker" Width="146" Height="52"/>
        <Grid x:Name="StepContent" Margin="0,20,0,0">
          <StackPanel x:Name="LanguagePage">
            <TextBlock Text="Язык / Language" FontSize="22" FontWeight="SemiBold"/>
            <Border Background="{StaticResource AccentBrush}" Width="28" Height="2" CornerRadius="1" HorizontalAlignment="Left" Margin="0,9,0,15"/>
            <Button x:Name="RussianButton" Style="{StaticResource ChoiceButton}" AutomationProperties.Name="Русский" Click="Russian_Click">
              <StackPanel Orientation="Horizontal">
                <ContentControl Content="RU" ContentTemplate="{StaticResource RussianFlag}" Margin="0,0,11,0"/>
                <TextBlock Text="Русский"/>
              </StackPanel>
            </Button>
            <Button x:Name="EnglishButton" Style="{StaticResource ChoiceButton}" AutomationProperties.Name="English" Click="English_Click">
              <StackPanel Orientation="Horizontal">
                <ContentControl Content="EN" ContentTemplate="{StaticResource EnglishFlag}" Margin="0,0,11,0"/>
                <TextBlock Text="English"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel x:Name="WindowsPage" Visibility="Collapsed">
            <TextBlock x:Name="WindowsTitle" FontSize="22" FontWeight="SemiBold"/>
            <Border Background="{StaticResource AccentBrush}" Width="28" Height="2" CornerRadius="1" HorizontalAlignment="Left" Margin="0,9,0,15"/>
            <Button x:Name="Windows10Button" Style="{StaticResource ChoiceButton}" AutomationProperties.Name="Windows 10" Tag="10" Click="Windows_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ChoiceGlyph}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,11,0"
                      Data="M0,3 L8,2 V9 H0 Z M10,2 L20,0 V9 H10 Z M0,11 H8 V18 L0,17 Z M10,11 H20 V20 L10,18 Z"/>
                <TextBlock Text="Windows 10" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="Windows11Button" Style="{StaticResource ChoiceButton}" AutomationProperties.Name="Windows 11" Tag="11" Click="Windows_Click">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource ChoiceGlyph}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,11,0">
                  <Path.Data><GeometryGroup>
                    <RectangleGeometry Rect="0,0,9,9" RadiusX="1.5" RadiusY="1.5"/>
                    <RectangleGeometry Rect="11,0,9,9" RadiusX="1.5" RadiusY="1.5"/>
                    <RectangleGeometry Rect="0,11,9,9" RadiusX="1.5" RadiusY="1.5"/>
                    <RectangleGeometry Rect="11,11,9,9" RadiusX="1.5" RadiusY="1.5"/>
                  </GeometryGroup></Path.Data>
                </Path>
                <TextBlock Text="Windows 11" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Grid Margin="0,5,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button x:Name="BackButton" Style="{StaticResource SetupButton}" Background="#131316"
                      Foreground="#D4D4D8" MinWidth="88" Click="Back_Click"
                      AutomationProperties.Name="{Binding Text, ElementName=BackLabel}">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M5,1 L1,5 L5,9" Stroke="#B6B6BC" StrokeThickness="1.4"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="BackLabel" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock x:Name="WindowsHint" Grid.Column="1" Margin="12,0,0,0"
                         FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                         TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
