<Window x:Class="MagnumTweaker.TermsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:MagnumTweaker"
        Icon="../../Assets/MagnumTweaker.ico" Width="665" Height="550" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" Background="#0B0B0D" Foreground="#F5F5F6" FontFamily="{StaticResource InterfaceFont}"
        UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#3A3A3E" BorderThickness="1" CornerRadius="10" Background="#0B0B0D" Padding="25,17,25,21">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.ColumnSpan="2">
          <ContentControl ContentTemplate="{StaticResource BrandMark}" Content="Magnum Tweaker"
                          Width="166" Height="56" HorizontalAlignment="Center" Margin="0,0,0,9"/>
          <TextBlock x:Name="Heading" FontFamily="{StaticResource HeadingFont}" FontSize="24" FontWeight="Bold" TextAlignment="Center"/>
        </StackPanel>
        <Button x:Name="CloseTermsButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="×" FontSize="20"
                VerticalAlignment="Top"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
      </Grid>
      <Border Grid.Row="1" Background="#131316" BorderBrush="#333337" BorderThickness="1" CornerRadius="7" Padding="2">
        <local:SmoothScrollViewer x:Name="TermsScroll" Background="#131316" AutomationProperties.Name="{Binding Text, ElementName=Heading}">
          <TextBlock x:Name="TermsBody" Foreground="#DDDDE0" TextWrapping="Wrap" FontSize="13" LineHeight="20" Margin="13,11">
            <TextBlock.CacheMode><BitmapCache EnableClearType="True" SnapsToDevicePixels="True"/></TextBlock.CacheMode>
          </TextBlock>
        </local:SmoothScrollViewer>
      </Border>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,17,0,0">
        <Button x:Name="DeclineButton" Click="Close_Click" MinWidth="105"/>
        <Button x:Name="AcceptButton" Margin="8,0,0,0" MinWidth="122" Background="{StaticResource AccentBrush}" Foreground="#171719" Click="Accept_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
