<Window x:Class="MagnumTweaker.RestorePointWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="540" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" Background="{StaticResource BackgroundBrush}" ShowInTaskbar="False"
        FontFamily="{StaticResource InterfaceFont}" Foreground="White">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" GlassFrameThickness="0" ResizeBorderThickness="0"
                        CornerRadius="13" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border CornerRadius="13" BorderThickness="1" BorderBrush="{StaticResource GlassEdge}"
          Background="{StaticResource GlassSurface}">
    <Grid Margin="24,14,16,23">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,13">
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Height="34" VerticalAlignment="Center"
                Style="{StaticResource ChromeButton}" ContentTemplate="{StaticResource CloseGlyph}"
                ToolTip="{DynamicResource Close}" AutomationProperties.Name="{DynamicResource Close}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
        <Border DockPanel.Dock="Left" Background="#18FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1"
                Width="34" Height="34" CornerRadius="9" Margin="0,0,12,0">
          <Path Width="16" Height="18" Stretch="Uniform" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5"
                Data="M8,1 L15,4 V9 C15,13 12,16 8,18 C4,16 1,13 1,9 V4 Z M4.5,9 L7,11.5 L11.5,7"/>
        </Border>
        <TextBlock x:Name="Heading" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="22" FontWeight="Bold"
                   FontFamily="{StaticResource HeadingFont}"/>
      </DockPanel>
      <StackPanel Grid.Row="1" Margin="0,0,8,0">
        <TextBlock x:Name="Explanation" TextWrapping="Wrap" FontSize="13" LineHeight="21"/>
        <Border Background="#36000000" BorderBrush="#21FFFFFF" BorderThickness="1" CornerRadius="8"
                Padding="12,9" Margin="0,14,0,17">
          <TextBlock x:Name="Status" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <WrapPanel HorizontalAlignment="Right">
          <Button x:Name="ContinueButton" Height="35" Margin="0,0,8,0" Padding="12,0" Click="Continue_Click"/>
          <Button x:Name="CreateButton" Height="35" Padding="14,0" Click="Create_Click"
                  Style="{StaticResource GlassApplyButton}"/>
        </WrapPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
