<Application x:Class="MagnumTweaker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MagnumTweaker">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#080809"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#AAAAAE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="GlassEdge" Color="#65FFFFFF"/>
    <LinearGradientBrush x:Key="GlassSurface" StartPoint="0,0" EndPoint="0.8,1">
      <GradientStop Color="#303137" Offset="0"/><GradientStop Color="#141419" Offset="0.62"/><GradientStop Color="#101013" Offset="1"/>
    </LinearGradientBrush>
    <FontFamily x:Key="InterfaceFont">./Assets/Fonts/#Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="HeadingFont">./Assets/Fonts/#Manrope ExtraLight, Segoe UI</FontFamily>
    <Style TargetType="ToolTip">
      <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}"/>
    </Style>

    <Geometry x:Key="GearIcon">M7,0 H9 L9.5,2 L11,2.8 L13,2 L14.4,3.5 L13.6,5.3 L14.3,6.7 L16,7 V9 L14.2,9.4 L13.5,11 L14.4,12.7 L13,14.2 L11,13.4 L9.5,14 L9,16 H7 L6.5,14 L5,13.4 L3,14.2 L1.6,12.7 L2.5,11 L1.8,9.4 L0,9 V7 L1.7,6.7 L2.4,5.3 L1.6,3.5 L3,2 L5,2.8 L6.5,2 Z M10.6,8 A2.6,2.6 0 1 0 5.4,8 A2.6,2.6 0 1 0 10.6,8 Z</Geometry>
    <DataTemplate x:Key="RussianFlag">
      <Border Width="23" Height="16" CornerRadius="3" BorderBrush="#68686C" BorderThickness="0.6">
        <UniformGrid Rows="3" Columns="1"><Border Background="White" CornerRadius="2,2,0,0"/><Border Background="#17469E"/><Border Background="#D52B39" CornerRadius="0,0,2,2"/></UniformGrid>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="EnglishFlag">
      <Border Width="23" Height="16" BorderBrush="#68686C" BorderThickness="0.6">
        <Viewbox Stretch="Fill">
          <Canvas Width="24" Height="16" Background="#17346B" ClipToBounds="True">
            <Path Stroke="White" StrokeThickness="4" Data="M0,0 L24,16 M24,0 L0,16"/>
            <Path Stroke="#C93142" StrokeThickness="1.4" Data="M0,0 L24,16 M24,0 L0,16"/>
            <Path Stroke="White" StrokeThickness="5.5" Data="M12,0 V16 M0,8 H24"/>
            <Path Stroke="#C93142" StrokeThickness="3" Data="M12,0 V16 M0,8 H24"/>
          </Canvas>
        </Viewbox>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="BrandMark">
      <Image Source="Assets/Brand.png" Stretch="Uniform" AutomationProperties.Name="Magnum Tweaker"
             RenderOptions.BitmapScalingMode="HighQuality"/>
    </DataTemplate>

    <Style TargetType="Button">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="#1C1C1F"/>
      <Setter Property="Foreground" Value="#F5F5F6"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
              <Border x:Name="Hover" Background="White" Opacity="0" CornerRadius="6"/>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.075" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/></Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#A5A5A9"/>
      <Setter Property="Cursor" Value="Arrow"/>
    </Style>

    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Border Width="2" Background="#29292B" CornerRadius="1"/>
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="25">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                          <Border x:Name="Grip" Width="3" Background="#55555A" CornerRadius="2"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#74747A"/></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#85858B"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type local:SmoothScrollViewer}">
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="CanContentScroll" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type local:SmoothScrollViewer}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                      Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      CanContentScroll="{TemplateBinding CanContentScroll}"/>
              <Border Height="27" VerticalAlignment="Top" Background="{TemplateBinding Background}"
                      IsHitTestVisible="False" Opacity="{TemplateBinding TopFadeOpacity}">
                <Border.OpacityMask>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Black" Offset="0"/><GradientStop Color="Transparent" Offset="1"/>
                  </LinearGradientBrush>
                </Border.OpacityMask>
              </Border>
              <Border Height="27" VerticalAlignment="Bottom" Background="{TemplateBinding Background}"
                      IsHitTestVisible="False" Opacity="{TemplateBinding BottomFadeOpacity}">
                <Border.OpacityMask>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0"/><GradientStop Color="Black" Offset="1"/>
                  </LinearGradientBrush>
                </Border.OpacityMask>
              </Border>
              <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Margin="9,0,0,0"
                         Style="{StaticResource ThinScrollBar}" Orientation="Vertical"
                         Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                         Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolbarToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#E4E4E7"/>
      <Setter Property="Background" Value="#111114"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1"
                    CornerRadius="7" Padding="11,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="15"/></Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Path x:Name="Arrow" Grid.Column="1" Data="M 1,1 L 6,6 L 11,1" Stroke="#929297" StrokeThickness="1.4"
                      Width="12" Height="7" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#1A1A1D"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#79797F"/>
                <Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#BCBCC1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolbarCombo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E4E4E7"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="9,8"><ContentPresenter/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#313137"/></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#36363A"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource ToolbarToggle}" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                  <Path Fill="#929297" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                        Data="M0,1 H14 V3 H0 Z M0,6 H10 V8 H0 Z M0,11 H5 V13 H0 Z"/>
                  <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
                </StackPanel>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="5" AllowsTransparency="True"
                     IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                <Border TextElement.FontFamily="{StaticResource InterfaceFont}" Background="#18181A" BorderBrush="#3B3B40" BorderThickness="1" CornerRadius="6" Padding="4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
