<Window x:Class="MagnumTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:MagnumTweaker"
        Title="Magnum Tweaker" Icon="Assets/MagnumTweaker.ico" Width="1120" Height="740" MinWidth="820" MinHeight="530"
        WindowStartupLocation="CenterScreen" Background="#080809"
        Foreground="#F5F5F6" FontFamily="{StaticResource InterfaceFont}" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="10" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <RadialGradientBrush x:Key="MainAmbientGlow" Center="0.5,0.48" GradientOrigin="0.5,0.48" RadiusX="0.5" RadiusY="0.5">
      <GradientStop Color="#46F5F5FF" Offset="0"/>
      <GradientStop Color="#25E7E7F5" Offset="0.54"/>
      <GradientStop Color="#00E7E7F5" Offset="1"/>
    </RadialGradientBrush>
    <BooleanToVisibilityConverter x:Key="BooleanVisibility"/>
    <Style x:Key="DetailsChevron" TargetType="ToggleButton">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="Surface" CornerRadius="5" Background="Transparent">
          <Grid Width="12" Height="12">
            <Path Stroke="#CCCCD0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M2,4 L6,8 L10,4" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform><RotateTransform x:Name="Turn"/></Path.RenderTransform>
            </Path>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#333339"/></Trigger>
          <Trigger Property="IsChecked" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Turn" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Turn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="BorderBrush" Value="#323238"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="5,1"/>
      <Setter Property="Margin" Value="0,2,4,0"/>
      <Setter Property="TextBlock.Foreground" Value="#B5B5BB"/>
      <Setter Property="TextBlock.FontSize" Value="10"/>
    </Style>
    <Style x:Key="VolumeRail" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent">
              <Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2" VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="VolumeControl" TargetType="Slider">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Border x:Name="VolumeFrame" Background="#131316" BorderBrush="#353538" BorderThickness="1" CornerRadius="14" Padding="6,0">
              <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource VolumeRail}" Background="#C43A4F" Command="Slider.DecreaseLarge"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource VolumeRail}" Background="#49494D" Command="Slider.IncreaseLarge"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Height="16" Width="16" Focusable="False">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Knob" CornerRadius="8" Background="#E7E7EA" BorderBrush="#A4A4AB" BorderThickness="2"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="BorderBrush" Value="#DF4D62"/></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Background" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="VolumeFrame" Property="BorderBrush" Value="#B74456"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#ADADB1"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Height="45" Background="Transparent">
              <Border x:Name="Selection" Background="Transparent" CornerRadius="6" Margin="10,2"/>
              <ContentPresenter Margin="23,0,10,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="#262628"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="White"/>
                <Setter TargetName="Selection" Property="Background" Value="#26262C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SearchField" TargetType="TextBox">
      <Setter Property="Foreground" Value="#F5F5F6"/>
      <Setter Property="CaretBrush" Value="#F5F5F6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Frame" Background="#111114" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7">
              <Grid Margin="13,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Path Stroke="#929297" StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform"
                      VerticalAlignment="Center" HorizontalAlignment="Left" Data="M 11,6 A 5,5 0 1 1 1,6 A 5,5 0 1 1 11,6 M 10,10 L 15,15"/>
                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Focusable="False"/>
                <TextBlock x:Name="Watermark" Grid.Column="1" Text="{DynamicResource Search}" VerticalAlignment="Center"
                           Foreground="#A5A5AA" IsHitTestVisible="False" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="Text" Value=""/>
                  <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
              </MultiTrigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Frame" Property="BorderBrush" Value="#B8B8BC"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Border Background="{StaticResource BackgroundBrush}" BorderBrush="#343436" BorderThickness="1" CornerRadius="10"
          ClipToBounds="True">
    <Grid>
    <Grid x:Name="MainLayout" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><ScaleTransform x:Name="WindowScale"/></Grid.RenderTransform>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="Sidebar" Width="215" ClipToBounds="True" Background="#0C0C0F" BorderBrush="#303032" BorderThickness="0,0,1,0" CornerRadius="9,0,0,9">
        <DockPanel LastChildFill="True">
          <Grid DockPanel.Dock="Top" Height="120">
            <Border Background="{StaticResource MainAmbientGlow}" Margin="0,5" IsHitTestVisible="False"/>
            <ContentControl x:Name="SidebarBrand" ContentTemplate="{StaticResource BrandMark}" Content="Magnum Tweaker"
                            Width="163" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <Border DockPanel.Dock="Bottom" BorderBrush="#303032" BorderThickness="0,1,0,0" Padding="12,9,12,12">
            <StackPanel>
              <Button x:Name="SidebarGuide" AutomationProperties.Name="{DynamicResource Reference}" Content="{DynamicResource Reference}" ToolTip="{DynamicResource Reference}" Padding="0" Background="#131316" Height="34" Margin="0,0,0,5" Click="Reference_Click"/>
              <Button x:Name="SettingsButton" Background="#131316" Height="38" Click="Settings_Click" ToolTip="{DynamicResource Settings}" AutomationProperties.Name="{DynamicResource Settings}">
                <StackPanel Orientation="Horizontal">
                  <Path x:Name="SidebarGear" Data="{StaticResource GearIcon}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,9,0" RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform x:Name="SidebarGearRotation"/></Path.RenderTransform>
                    <Path.Style><Style TargetType="Path">
                      <Setter Property="Fill" Value="#A4A4A8"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible, ElementName=SettingsOverlay}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style></Path.Style>
                  </Path>
                  <TextBlock x:Name="SidebarSettingsLabel" Text="{DynamicResource Settings}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock x:Name="ProfileText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="11,10,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel>
            <Grid Margin="8,0,8,6">
              <TextBlock x:Name="SidebarHeading" Text="{DynamicResource Categories}" Margin="15,0,36,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
              <Button x:Name="SidebarToggle" HorizontalAlignment="Right" Width="32" Padding="0" ToolTip="{DynamicResource ToggleSidebar}" AutomationProperties.Name="{DynamicResource ToggleSidebar}" Click="SidebarToggle_Click">
                <Button.FocusVisualStyle>
                  <Style TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate>
                    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False"/>
                  </ControlTemplate></Setter.Value></Setter></Style>
                </Button.FocusVisualStyle>
                <Grid Width="12" Height="12">
                  <Path Data="M8,2 L4,6 L8,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><RotateTransform x:Name="SidebarArrowRotation"/></Path.RenderTransform>
                  </Path>
                </Grid>
              </Button>
            </Grid>
            <Grid>
              <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Padding="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource NavigationItem}" SelectionChanged="CategoryList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}">
                      <Path Data="{Binding Icon}" Width="15" Height="15" Stretch="Uniform"
                            StrokeThickness="1.35" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Margin="0,0,11,0">
                        <Path.Style><Style TargetType="Path">
                          <Setter Property="Stroke" Value="#949499"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                              <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style></Path.Style>
                      </Path>
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Visibility="{Binding SidebarLabelsVisibility, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Width="3" Height="18" CornerRadius="0,3,3,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                      Margin="0,14,0,0" Background="{StaticResource AccentBrush}" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform x:Name="CategoryMarker"/></Border.RenderTransform><Border.Effect><DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="9" Opacity="0.5"/></Border.Effect>
              </Border>
            </Grid>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="26,0,20,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="42"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition/><RowDefinition Height="41"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,-14,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBlock Text="v1.1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" FontSize="11"/>
          <Button Style="{StaticResource ChromeButton}" ToolTip="{DynamicResource Minimize}" AutomationProperties.Name="{DynamicResource Minimize}" Click="Minimize_Click">
            <Path Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M 0,7 L 12,7"/>
          </Button>
          <Button Style="{StaticResource ChromeButton}" ToolTip="{DynamicResource Maximize}" AutomationProperties.Name="{DynamicResource Maximize}" Click="Maximize_Click">
            <Path x:Name="MaximizeGlyph" Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M 1,1 H 11 V 11 H 1 Z"/>
          </Button>
          <Button Style="{StaticResource ChromeButton}" ToolTip="{DynamicResource Close}" AutomationProperties.Name="{DynamicResource Close}" Click="Close_Click">
            <Path Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M 1,1 L 11,11 M 11,1 L 1,11"/>
          </Button>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,6,18,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock x:Name="SectionTitle" FontFamily="{StaticResource HeadingFont}" FontSize="25" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SummaryText" Text="{DynamicResource ScanPrompt}"
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
          </StackPanel>
          <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
            <Border Background="{StaticResource MainAmbientGlow}" Margin="-29,-18,-29,-18" IsHitTestVisible="False"/>
            <Button Content="{DynamicResource ScanAll}" Background="{StaticResource AccentBrush}" Foreground="#171719" Click="ScanAll_Click"/>
          </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,18,15">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="222"/><ColumnDefinition Width="10"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}" Height="43" AutomationProperties.Name="{DynamicResource Search}" TextChanged="SearchBox_TextChanged"/>
          <ComboBox x:Name="SortBox" Grid.Column="2" Style="{StaticResource ToolbarCombo}" SelectedValuePath="Mode"
                    AutomationProperties.Name="{DynamicResource Sort}" SelectionChanged="SearchOptions_SelectionChanged">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ToggleButton x:Name="FilterButton" Grid.Column="4" Style="{StaticResource ToolbarToggle}" FontWeight="SemiBold"
                        AutomationProperties.Name="{DynamicResource Filters}">
            <StackPanel Orientation="Horizontal">
              <Path Fill="#929297" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                    Data="M0,0 H14 V2 L9,8 V12 L5,14 V8 L0,2 Z"/>
              <TextBlock x:Name="FilterLabel" Text="{DynamicResource Filters}" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <Popup TextElement.FontFamily="{StaticResource InterfaceFont}" x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom" VerticalOffset="5"
                 IsOpen="{Binding IsChecked, ElementName=FilterButton, Mode=TwoWay}" StaysOpen="False"
                 AllowsTransparency="True" PopupAnimation="Fade" Opened="FilterPopup_Opened">
            <Border Background="#18181A" BorderBrush="#3B3B40" BorderThickness="1" CornerRadius="7" Padding="14" Width="216"
                    PreviewKeyDown="FilterPopup_PreviewKeyDown">
              <Border.Resources>
                <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#E4E4E7"/></Style>
              </Border.Resources>
              <StackPanel>
                <TextBlock Text="{DynamicResource StatusFilter}" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <RadioButton x:Name="StatusAny" Content="{DynamicResource AnyStatus}" GroupName="Status" Tag="" Checked="StatusFilter_Checked" Margin="0,0,0,6"/>
                <RadioButton Content="{DynamicResource AppliedFilter}" GroupName="Status" Tag="Applied" Checked="StatusFilter_Checked" Margin="0,0,0,6"/>
                <RadioButton Content="{DynamicResource NotAppliedFilter}" GroupName="Status" Tag="NotApplied" Checked="StatusFilter_Checked" Margin="0,0,0,6"/>
                <RadioButton Content="{DynamicResource UncheckedFilter}" GroupName="Status" Tag="Unknown" Checked="StatusFilter_Checked"/>
                <Border Height="1" Background="#3B3B40" Margin="0,12"/>
                <TextBlock Text="{DynamicResource RiskFilter}" FontWeight="SemiBold" Margin="0,0,0,7"/>
                <RadioButton x:Name="RiskAny" Content="{DynamicResource AnyRisk}" GroupName="Risk" Tag="" Checked="RiskFilter_Checked" Margin="0,0,0,6"/>
                <RadioButton Content="{DynamicResource SafeFilter}" GroupName="Risk" Tag="Safe" Checked="RiskFilter_Checked" Margin="0,0,0,6"/>
                <RadioButton Content="{DynamicResource ModerateFilter}" GroupName="Risk" Tag="Moderate" Checked="RiskFilter_Checked" Margin="0,0,0,6"/>
                <RadioButton Content="{DynamicResource ExperimentalFilter}" GroupName="Risk" Tag="Experimental" Checked="RiskFilter_Checked"/>
                <Button Content="{DynamicResource ResetFilters}" Margin="0,12,0,0" Click="ResetFilters_Click"/>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>

        <Grid Grid.Row="3" ClipToBounds="True">
          <Grid x:Name="Results">
          <Grid.RenderTransform><TranslateTransform x:Name="ResultsMotion"/></Grid.RenderTransform>
          <ItemsControl x:Name="TweaksList" Margin="0,0,0,12"
                        VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.Template><ControlTemplate TargetType="ItemsControl">
                <local:SmoothScrollViewer x:Name="PART_TweakScroll" AutomationProperties.AutomationId="TweakScroll" CanContentScroll="True" ShowTopFade="False"><ItemsPresenter/></local:SmoothScrollViewer>
              </ControlTemplate></ItemsControl.Template>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,6">
                    <Border CornerRadius="8" Background="#111114" BorderBrush="#1D1D23" BorderThickness="1"/>
                    <Border x:Name="ActivationGlow" Background="#1535D07F" BorderBrush="#42D789" BorderThickness="1"
                            CornerRadius="8" Opacity="0" IsHitTestVisible="False"/>
                    <Grid Margin="12,8">
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="231"/></Grid.ColumnDefinitions>
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Ellipse Width="7" Height="7" Fill="{Binding StateColor}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,9,0,0"/>
                        <DockPanel Grid.Column="1">
                          <ToggleButton DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,5,0"
                                        IsChecked="{Binding DetailsExpanded}" Style="{StaticResource DetailsChevron}"
                                        ToolTip="{DynamicResource Details}" AutomationProperties.Name="{DynamicResource Details}"/>
                          <TextBlock Text="{Binding DisplayTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>
                        <WrapPanel Grid.Row="1" Grid.Column="1" Margin="0,3,0,0">
                          <Border Style="{StaticResource Badge}"><StackPanel Orientation="Horizontal">
                            <Path Width="9" Height="9" Margin="0,0,5,0" Stretch="Uniform" Fill="#A6A6AC" Data="M0,0 H4 V4 H0 Z M6,0 H10 V4 H6 Z M0,6 H4 V10 H0 Z M6,6 H10 V10 H6 Z"/>
                            <TextBlock Text="{Binding WindowsText}"/>
                          </StackPanel></Border>
                          <Border Style="{StaticResource Badge}" Visibility="{Binding HardwareBadgeVisibility}">
                            <StackPanel Orientation="Horizontal">
                              <Path Width="10" Height="9" Margin="0,0,5,0" Stretch="Uniform" Stroke="#A6A6AC" Data="{Binding HardwareIcon}"/>
                              <TextBlock Text="{Binding Hardware}" FontStyle="{Binding HardwareBadgeFontStyle}" FontWeight="{Binding HardwareBadgeWeight}"/>
                            </StackPanel>
                          </Border>
                          <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding RiskText}"/></Border>
                          <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding RestartText}"/></Border>
                        </WrapPanel>
                      </Grid>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateText}" Foreground="{Binding StateColor}" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Margin="0,0,0,9"/>
                        <Grid HorizontalAlignment="Right" Margin="0,-4,0,0">
                          <Button Height="27" Style="{StaticResource GlassApplyButton}" Content="{DynamicResource Apply}" Visibility="{Binding ShowApply, Converter={StaticResource BooleanVisibility}}" Click="ApplyOne_Click" Tag="{Binding}"/>
                          <Button Height="27" Style="{StaticResource GlassRestoreButton}" Content="{DynamicResource Restore}" Visibility="{Binding CanRestore, Converter={StaticResource BooleanVisibility}}" Click="RestoreOne_Click" Tag="{Binding}"/>
                        </Grid>
                      </StackPanel>
                      <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="16,8,0,0">
                        <StackPanel.Style><Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers><DataTrigger Binding="{Binding DetailsExpanded}" Value="True"><Setter Property="Visibility" Value="Visible"/><DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions></DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <TextBlock Text="{Binding DisplayDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Mechanism}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsActivationHighlighted}" Value="True">
                      <DataTrigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ActivationGlow" Storyboard.TargetProperty="Opacity" FillBehavior="Stop">
                              <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/>
                              <EasingDoubleKeyFrame Value="1" KeyTime="0:0:0.16">
                                <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseOut"/></EasingDoubleKeyFrame.EasingFunction>
                              </EasingDoubleKeyFrame>
                              <EasingDoubleKeyFrame Value="0" KeyTime="0:0:0.75">
                                <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                              </EasingDoubleKeyFrame>
                            </DoubleAnimationUsingKeyFrames>
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.EnterActions>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          <Border x:Name="PresetPanel" Visibility="Collapsed" VerticalAlignment="Top" Padding="22" CornerRadius="10"
                  BorderThickness="1" BorderBrush="{StaticResource GlassEdge}" Background="{StaticResource GlassSurface}">
            <StackPanel>
              <TextBlock Text="{DynamicResource PresetTitle}" FontFamily="{StaticResource HeadingFont}" FontSize="18" FontWeight="Bold"/>
              <TextBlock Text="{DynamicResource PresetDescription}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7"/>
              <TextBlock x:Name="PresetCounts" Margin="0,5,0,13"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Check}" Click="ScanAll_Click" Margin="0,0,8,0"/>
                <Button x:Name="PresetApply" Style="{StaticResource GlassApplyButton}" Content="{DynamicResource Apply}" Click="ApplySafe_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock x:Name="EmptyText" Text="{DynamicResource Empty}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="4" Text="{DynamicResource Ready}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Grid>
    <Grid x:Name="SettingsOverlay" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle"
          PreviewKeyDown="SettingsOverlay_PreviewKeyDown">
      <Border Background="#A6000000" MouseLeftButtonDown="SettingsBackdrop_Click"/>
      <Border x:Name="SettingsPanel" Width="565" MinHeight="292" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="{StaticResource GlassSurface}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1" CornerRadius="12" Padding="25">
        <Border.RenderTransform><TranslateTransform x:Name="SettingsMotion"/></Border.RenderTransform>
        <StackPanel>
          <Grid Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Data="{StaticResource GearIcon}" Fill="#F5F5F7" Width="17" Height="17" Stretch="Uniform" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                <Path.RenderTransform><RotateTransform x:Name="SettingsGearRotation"/></Path.RenderTransform>
              </Path>
              <TextBlock Text="{DynamicResource Settings}" FontFamily="{StaticResource HeadingFont}" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="CloseSettingsButton" Style="{StaticResource ChromeButton}" Background="#1A1A1D" Content="×" FontSize="20"
                    HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource Close}" Click="CloseSettings_Click"/>
          </Grid>
          <TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="{DynamicResource LanguageDescription}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12"/>
          <ToggleButton x:Name="LanguageDropdown" Style="{StaticResource ToolbarToggle}" Height="44" FontWeight="SemiBold"
                        AutomationProperties.Name="{DynamicResource Language}">
            <StackPanel Orientation="Horizontal">
              <ContentControl x:Name="CurrentFlag" Content="Flag" Margin="0,0,10,0"/>
              <TextBlock x:Name="CurrentLanguage" VerticalAlignment="Center"/>
            </StackPanel>
          </ToggleButton>
          <Border Background="#111114" CornerRadius="0,0,6,6" Padding="5,3">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsChecked, ElementName=LanguageDropdown}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <Button x:Name="RussianLanguageOption" Height="38" Background="Transparent" HorizontalContentAlignment="Left" Click="LanguageOption_Click" Tag="ru" AutomationProperties.Name="Русский">
                <StackPanel Orientation="Horizontal">
                  <ContentControl Content="RU" ContentTemplate="{StaticResource RussianFlag}" Margin="0,0,10,0"/>
                  <TextBlock Text="Русский" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="EnglishLanguageOption" Height="38" Background="Transparent" HorizontalContentAlignment="Left" Click="LanguageOption_Click" Tag="en" AutomationProperties.Name="English">
                <StackPanel Orientation="Horizontal">
                  <ContentControl Content="EN" ContentTemplate="{StaticResource EnglishFlag}" Margin="0,0,10,0"/>
                  <TextBlock Text="English" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
          <Border Height="1" Background="#343436" Margin="0,19"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,14,0">
              <TextBlock Text="{DynamicResource HoverVolume}" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="{DynamicResource HoverVolumeDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
            <Slider x:Name="HoverVolumeSlider" Grid.Column="1" Style="{StaticResource VolumeControl}" VerticalAlignment="Center" Minimum="0" Maximum="100"
                    TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10"
                    AutomationProperties.Name="{DynamicResource HoverVolume}" ValueChanged="HoverVolumeSlider_ValueChanged"/>
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=HoverVolumeSlider, StringFormat={}{0:0}%}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/>
          </Grid>
          <TextBlock Text="{DynamicResource ProfileLabel}" FontWeight="SemiBold" Margin="0,14,0,6"/>
          <ComboBox x:Name="ProfilePicker" Style="{StaticResource ToolbarCombo}" Height="40" SelectionChanged="ProfilePicker_SelectionChanged"/>
          <WrapPanel Margin="0,12,0,0">
            <Button Content="{DynamicResource Terms}" Background="#131316" Click="ViewTerms_Click"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
    </Grid>
  </Border>
</Window>
