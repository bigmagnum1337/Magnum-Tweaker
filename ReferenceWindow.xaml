<Window x:Class="MagnumTweaker.ReferenceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MagnumTweaker"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource Reference}" Width="760" Height="540" MinWidth="460" MinHeight="340" WindowStyle="None"
        WindowStartupLocation="CenterOwner" Icon="Assets/MagnumTweaker.ico" Background="#0B0B0D"
        FontFamily="{StaticResource InterfaceFont}" Foreground="White" ShowInTaskbar="False">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" GlassFrameThickness="0" ResizeBorderThickness="5" CornerRadius="10" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border CornerRadius="10" BorderThickness="1" BorderBrush="#3A3A3E"><Grid Margin="20,14">
    <Grid.RenderTransform><TranslateTransform x:Name="GuideMotion"/></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Style="{StaticResource ChromeButton}" Margin="8,0,0,0" VerticalAlignment="Center" Content="×" FontSize="20"
              AutomationProperties.Name="{DynamicResource Close}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click"/>
      <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#A9A9AE"/>
      <TextBlock Text="{DynamicResource Reference}" FontFamily="{StaticResource HeadingFont}" FontSize="22" FontWeight="Bold"/>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <DockPanel Background="#1A1A1D" Margin="0,0,8,0">
        <TextBlock Text="⌕" Margin="10,0,6,0" FontSize="20" VerticalAlignment="Center"/>
        <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                 MouseEnter="Search_MouseEnter" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Search}" TextChanged="FilterChanged"/>
      </DockPanel>
      <ComboBox x:Name="Sources" Grid.Column="1" Height="38" Style="{StaticResource ToolbarCombo}" SelectionChanged="FilterChanged"/>
    </Grid>
    <local:SmoothScrollViewer x:Name="Scroller" Grid.Row="2">
      <ItemsControl x:Name="Entries"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Background="#131316" BorderBrush="#333336" BorderThickness="1" CornerRadius="7" Padding="14,10" Margin="0,0,0,6">
          <StackPanel>
            <TextBlock Text="{Binding Label}" Foreground="#C799A0" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Margin="0,3" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Detail}" Foreground="#C0C0C4" TextWrapping="Wrap"/>
            <WrapPanel>
            <Button Content="{DynamicResource ShowTweak}" Tag="{Binding Action}" Visibility="{Binding ActionVisibility}"
                    HorizontalAlignment="Left" Margin="0,6,8,0" Padding="10,3" Click="ShowTweak_Click"/>
            <Button Content="{DynamicResource OpenSetting}" Tag="{Binding SettingsPage}" Visibility="{Binding LinkVisibility}"
                    HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,3" Click="OpenSetting_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </local:SmoothScrollViewer>
  </Grid></Border>
</Window>
